groups:
  - name: vmware-lab-node-utilization
    rules:
      - alert: NodeExporterDown
        expr: up{job="node-exporter"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Node exporter is down on {{ $labels.instance }}"
          description: "Prometheus cannot scrape node_exporter for {{ $labels.instance }}."

      - alert: HostHighCpuUsage
        expr: 100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job="node-exporter",mode="idle"}[5m]))) > ${cpu_threshold}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "CPU usage is above ${cpu_threshold}% on {{ $labels.instance }}"
          description: "{{ $labels.instance }} has had high CPU usage for at least 10 minutes."

      - alert: HostHighMemoryUsage
        expr: 100 * (1 - node_memory_MemAvailable_bytes{job="node-exporter"} / node_memory_MemTotal_bytes{job="node-exporter"}) > ${memory_threshold}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Memory usage is above ${memory_threshold}% on {{ $labels.instance }}"
          description: "{{ $labels.instance }} has had high memory usage for at least 10 minutes."

      - alert: HostHighFilesystemUsage
        expr: 100 * (1 - node_filesystem_avail_bytes{job="node-exporter",fstype!~"tmpfs|overlay|squashfs|nsfs"} / node_filesystem_size_bytes{job="node-exporter",fstype!~"tmpfs|overlay|squashfs|nsfs"}) > ${disk_threshold}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Filesystem usage is above ${disk_threshold}% on {{ $labels.instance }} {{ $labels.mountpoint }}"
          description: "{{ $labels.instance }} mount {{ $labels.mountpoint }} has had high disk usage for at least 10 minutes."

  - name: vmware-lab-kubernetes-health
    rules:
      - alert: KubernetesUnhealthyPods
        expr: sum(kube_pod_status_phase{phase=~"Pending|Failed|Unknown"}) > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Kubernetes has unhealthy pods"
          description: "One or more pods have been Pending, Failed, or Unknown for at least 10 minutes."

      - alert: KubernetesUnavailableDeploymentReplicas
        expr: sum(kube_deployment_status_replicas_unavailable) > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Kubernetes has unavailable deployment replicas"
          description: "One or more deployments have unavailable replicas for at least 10 minutes."

      - alert: KubernetesContainerRestarting
        expr: sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[15m])) > ${restart_threshold}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container restarts detected in {{ $labels.namespace }}/{{ $labels.pod }}"
          description: "{{ $labels.namespace }}/{{ $labels.pod }} restarted more than ${restart_threshold} times in 15 minutes."
