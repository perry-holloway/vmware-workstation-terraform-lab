global:
  scrape_interval: ${scrape_interval}
  evaluation_interval: ${scrape_interval}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: node-exporter
    static_configs:
      - targets: ["127.0.0.1:9100"]
        labels:
          instance: prometheus
