{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "central-prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(up{job=\"node-exporter\",instance=~\"$instance\"})", "refId": "A"}],
      "title": "Nodes Online",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "central-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 4, "w": 9, "x": 6, "y": 0},
      "id": 2,
      "options": {"displayMode": "gradient", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",instance=~\"$instance\",mode=\"idle\"}[$__rate_interval])))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "CPU Used",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "central-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "gridPos": {"h": 4, "w": 9, "x": 15, "y": 0},
      "id": 3,
      "options": {"displayMode": "gradient", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",instance=~\"$instance\"})", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Memory Used",
      "type": "bargauge"
    },
