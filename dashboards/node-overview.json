      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",instance=~\"$instance\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"} / node_filesystem_size_bytes{job=\"node-exporter\",instance=~\"$instance\",fstype!~\"tmpfs|overlay|squashfs|nsfs\"})", "legendFormat": "{{instance}} {{mountpoint}}", "refId": "A"}],
      "title": "Filesystem Used",
