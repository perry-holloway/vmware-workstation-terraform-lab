        {"expr": "node_load5{job=\"node-exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}} load5", "refId": "B"},
        {"expr": "node_load15{job=\"node-exporter\",instance=~\"$instance\"}", "legendFormat": "{{instance}} load15", "refId": "C"}
      ],
      "title": "System Load",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "central-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
