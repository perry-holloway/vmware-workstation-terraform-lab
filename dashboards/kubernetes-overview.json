      "targets": [{"expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",container!=\"\",image!=\"\"}[$__rate_interval]))", "legendFormat": "{{namespace}}", "refId": "A"}],
      "title": "CPU by Namespace",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "kubernetes-prometheus"},
