      "targets": [{"expr": "count(kube_node_info)", "refId": "A"}],
      "title": "Nodes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "kubernetes-prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "count(kube_namespace_created)", "refId": "A"}],
      "title": "Namespaces",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "kubernetes-prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(kube_pod_status_phase{phase=\"Running\"})", "refId": "A"}],
      "title": "Running Pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "kubernetes-prometheus"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"})", "refId": "A"}],
      "title": "Unhealthy Pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "kubernetes-prometheus"},
