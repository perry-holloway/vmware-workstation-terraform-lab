      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (namespace) (container_memory_working_set_bytes{namespace=~\"$namespace\",container!=\"\",image!=\"\"})", "legendFormat": "{{namespace}}", "refId": "A"}],
      "title": "Memory by Namespace",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "kubernetes-prometheus"},
