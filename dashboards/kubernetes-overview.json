      "targets": [{"expr": "sum by (namespace, deployment) (kube_deployment_status_replicas_unavailable{namespace=~\"$namespace\"})", "legendFormat": "{{namespace}}/{{deployment}}", "refId": "A"}],
      "title": "Unavailable Deployment Replicas",
